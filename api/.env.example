APP_NAME=Timejump
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Host port nginx is published on (docker-compose)
APP_PORT=8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=timejump
DB_USERNAME=timejump
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=33060

SESSION_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# --- Google Calendar (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/integrations/google/callback"

# --- Outlook / Microsoft 365 (https://entra.microsoft.com > App registrations) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI="${APP_URL}/api/integrations/outlook/callback"

# --- Timejump ---
TIMEJUMP_SYNC_PAST_DAYS=30
TIMEJUMP_SYNC_FUTURE_DAYS=365
# Optional: front-end URL the OAuth callback redirects to instead of returning JSON
TIMEJUMP_OAUTH_FRONTEND_REDIRECT=
# Never enable in production (allows iCal URLs on private/loopback networks)
TIMEJUMP_ICAL_ALLOW_PRIVATE_HOSTS=false
